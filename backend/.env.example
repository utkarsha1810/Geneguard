# Gene-Guard Backend — Environment Variables
# Copy this file to .env and fill in real values

# ─── Gemini API Keys (rotation pool) ─────────────────────────────────────
# Up to 4 keys from different Google accounts. Auto-rotates on 429.
# Get from: https://aistudio.google.com/apikey
# At least KEY_1 is required; 2-4 are optional for higher throughput.
GEMINI_KEY_1=your_gemini_key_1_here
GEMINI_KEY_2=your_gemini_key_2_here
GEMINI_KEY_3=your_gemini_key_3_here
GEMINI_KEY_4=your_gemini_key_4_here

# Legacy single-key variable (fallback if no KEY_1-4 are set)
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Server Configuration ────────────────────────────────────────────────
PORT=5050
NODE_ENV=production

# ─── MongoDB Atlas URI ───────────────────────────────────────────────────
# Free tier: https://www.mongodb.com/cloud/atlas/register
# Format: mongodb+srv://username:password@cluster.mongodb.net/gene-guard?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/gene-guard?retryWrites=true&w=majority

# ─── Frontend URL (for CORS) ─────────────────────────────────────────────
# Set this to your Vercel deployment URL after deploying
FRONTEND_URL=https://your-app-name.vercel.app

# ─── Agora RTC & Chat Server Configuration ───────────────────────────────
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_certificate

# ─── Auth Configuration ──────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret
ADMIN_SECRET_CODE=your_admin_code

