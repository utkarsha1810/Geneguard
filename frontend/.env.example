# Gene-Guard Frontend — Environment Variables
# Copy this file to .env and fill in real values

# ─── Gemini API Keys (rotation pool) ─────────────────────────────────────
# Up to 4 keys from different Google accounts. The app auto-rotates
# to the next key when one gets a 429 (quota exhausted) error.
# Get keys from: https://aistudio.google.com/apikey
# At least KEY_1 is required; 2-4 are optional for higher throughput.
REACT_APP_GEMINI_KEY_1=your_gemini_key_1_here
REACT_APP_GEMINI_KEY_2=your_gemini_key_2_here
REACT_APP_GEMINI_KEY_3=your_gemini_key_3_here
REACT_APP_GEMINI_KEY_4=your_gemini_key_4_here

# Legacy single-key variable (fallback if no KEY_1-4 are set)
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here

# ─── Backend API URL ─────────────────────────────────────────────────────
# Set to deployed backend URL for production
# Leave empty for local development (defaults to http://localhost:5050/api/dna)
REACT_APP_API_URL=

# ─── Agora RTC & Chat Configuration ──────────────────────────────────────
REACT_APP_AGORA_APP_ID=your_agora_app_id
REACT_APP_AGORA_CHAT_APP_KEY=your_agora_chat_app_key
