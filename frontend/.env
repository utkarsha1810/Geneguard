# Gene-Guard Frontend Configuration

# ─── Gemini API Keys (rotation pool) ─────────────────────────────────────
# Up to 4 keys from different Google accounts. The app will auto-rotate
# to the next key when one gets a 429 (quota exhausted) error.
# Get keys from: https://aistudio.google.com/apikey
REACT_APP_GEMINI_KEY_1=AIzaSyCebs3AV3OhvoFkXw219dnnsJ8CJzo8X8U
REACT_APP_GEMINI_KEY_2=AIzaSyCqjjN0QkpiFDKmcxSXdr7ZeNQR5C7ROiM
REACT_APP_GEMINI_KEY_3=AIzaSyB-E0GY0kuubPHLaw4avCTVa901yTA27kY
REACT_APP_GEMINI_KEY_4=AIzaSyDzjPp2yiBK8Eq-Z6Dt0n_J5Qktpyhk1iQ

# Legacy single-key variable (still supported as fallback)
REACT_APP_GEMINI_API_KEY=AIzaSyCebs3AV3OhvoFkXw219dnnsJ8CJzo8X8U

# Backend API URL — set to deployed backend URL for production
# Leave empty or omit for local development (defaults to http://localhost:5050/api/dna)
REACT_APP_API_URL=

# ─── Agora RTC & Chat Configuration ──────────────────────────────────────
REACT_APP_AGORA_APP_ID=your_agora_app_id
REACT_APP_AGORA_CHAT_APP_KEY=your_agora_chat_app_key

# ─── Build & Performance Optimization ──────────────────────────────────
DISABLE_ESLINT_PLUGIN=true
FAST_REFRESH=true


